    <a href="#services">Services</a>
    <a href="#" class="lets-talk" style="color:var(--yellow)">Let's Talk</a>
  </div>
</header>

<!-- LET'S TALK POPUP -->
<div class="popup-backdrop" id="popup">
  <div class="popup">
    <h3>Let's Talk</h3>
    <p>Choose how you want to reach me.</p>
    <div class="popup-btns">
      <a class="yellow" href="mailto:necanorchristylynn@gmail.com">✉ &nbsp;Email Me</a>
      <a class="ghost" href="https://wa.me/639094161927" target="_blank" rel="noopener">💬 &nbsp;WhatsApp</a>
