<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Social Media Manager Portfolio</title>
<style>
  :root{
    --bg:#160a2e;
    --bg2:#1e0f3c;
    --card:#251247;
    --card2:#2d1757;
    --purple:#7b4dff;
    --purple-soft:#a78bfa;
    --yellow:#ffd335;
    --white:#ffffff;
    --muted:#b7a8e0;
    --border:rgba(167,139,250,.22);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg);
    color:var(--white);
    font-family:'Segoe UI',Helvetica,Arial,sans-serif;
    line-height:1.6;
    overflow-x:hidden;
  }
  img{display:block;max-width:100%}

  /* ---------- NAV ---------- */
  header{
    position:sticky;top:0;z-index:100;
    background:rgba(22,10,46,.9);
    backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);
  }
  .nav{
    max-width:1200px;margin:0 auto;
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 24px;
  }
  .nav-logo img{height:40px;width:auto}
  .nav-links{display:flex;align-items:center;gap:28px;list-style:none}
  .nav-links a{
    color:var(--muted);text-decoration:none;font-size:13px;
    font-weight:600;letter-spacing:1.2px;text-transform:uppercase;
    transition:color .25s;
  }
  .nav-links a:hover{color:var(--yellow)}
  .nav-cta{
    background:var(--yellow);color:#1a0b33 !important;
    padding:10px 20px;border-radius:999px;font-weight:700 !important;
    transition:transform .2s, box-shadow .2s;
  }
  .nav-cta:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(255,211,53,.35);color:#1a0b33 !important}
  .burger{display:none;background:none;border:none;color:var(--white);cursor:pointer;font-size:26px}
  .mobile-menu{display:none;flex-direction:column;gap:2px;padding:10px 24px 20px;background:rgba(22,10,46,.97);border-bottom:1px solid var(--border)}
  .mobile-menu a{color:var(--muted);text-decoration:none;font-size:14px;letter-spacing:1px;text-transform:uppercase;padding:10px 0;border-bottom:1px solid rgba(167,139,250,.1)}
  .mobile-menu.open{display:flex}
  @media(max-width:860px){
    .nav-links{display:none}
    .burger{display:block}
  }

  /* ---------- LET'S TALK POPUP ---------- */
  .popup-backdrop{
    display:none;position:fixed;inset:0;z-index:200;
    background:rgba(10,4,24,.8);backdrop-filter:blur(6px);
    align-items:center;justify-content:center;
  }
  .popup-backdrop.show{display:flex}
  .popup{
    background:var(--card);border:1px solid var(--border);
    border-radius:20px;padding:40px 48px;text-align:center;
    box-shadow:0 30px 80px rgba(0,0,0,.5);max-width:90vw;
  }
  .popup h3{font-size:22px;margin-bottom:6px}
  .popup p{color:var(--muted);font-size:14px;margin-bottom:24px}
  .popup-btns{display:flex;flex-direction:column;gap:12px}
  .popup-btns a{
    display:flex;align-items:center;justify-content:center;gap:10px;
    padding:14px 32px;border-radius:999px;text-decoration:none;
    font-weight:700;font-size:15px;transition:transform .2s;
  }
  .popup-btns a:hover{transform:translateY(-2px)}
  .popup-btns a.yellow{background:var(--yellow);color:#1a0b33}
  .popup-btns a.ghost{border:1px solid rgba(255,255,255,.35);color:var(--white)}
  .popup-close{
    margin-top:22px;background:none;border:none;color:var(--muted);
    cursor:pointer;font-size:13px;letter-spacing:1px;text-transform:uppercase;
  }
  .popup-close:hover{color:var(--white)}

  /* ---------- SHARED ---------- */
  .section{max-width:1200px;margin:0 auto;padding:90px 24px}
  .kicker{
    color:var(--yellow);font-size:12px;font-weight:700;
    letter-spacing:3px;text-transform:uppercase;margin-bottom:14px;
    display:block;
  }
  h2{font-size:clamp(30px,4.5vw,48px);line-height:1.15;font-weight:800;letter-spacing:-.5px;margin-bottom:18px}
  .muted{color:var(--muted);max-width:640px}
  .center{text-align:center}
  .center .muted{margin:0 auto}

  /* ---------- HERO ---------- */
  .hero{
    max-width:1200px;margin:0 auto;padding:70px 24px 40px;
    display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center;
    position:relative;
  }
  .hero::before{
    content:'';position:absolute;top:-10%;left:-15%;width:520px;height:520px;
    background:radial-gradient(circle,rgba(123,77,255,.28),transparent 65%);
    pointer-events:none;
  }
  .hero-copy{position:relative;z-index:2}
  .hero-copy h1{
    font-size:clamp(38px,5.4vw,66px);line-height:1.06;
    font-weight:900;letter-spacing:-1.5px;margin:16px 0 22px;
  }
  .hero-copy h1 .yellow{color:var(--yellow)}
  .hero-sub{color:var(--muted);font-size:17px;max-width:480px;margin-bottom:34px}
  .hero-btns{display:flex;gap:16px;flex-wrap:wrap}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:16px 32px;border-radius:999px;font-weight:700;font-size:15px;
    text-decoration:none;transition:transform .2s,box-shadow .2s;cursor:pointer;border:none;
  }
  .btn-yellow{background:var(--yellow);color:#1a0b33}
  .btn-yellow:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(255,211,53,.35)}
  .btn-ghost{background:transparent;color:var(--white);border:1px solid rgba(255,255,255,.35)}
  .btn-ghost:hover{border-color:var(--yellow);color:var(--yellow);transform:translateY(-3px)}

  .hero-visual{position:relative;z-index:1}
  .profile-wrap{
    position:relative;display:flex;justify-content:center;
  }
  .profile-img{
    width:min(420px,90%);
    height:auto;
    object-fit:contain;
    border:none;outline:none;background:transparent;
    filter:drop-shadow(0 0 50px rgba(255,211,53,.30)) drop-shadow(0 24px 60px rgba(123,77,255,.45));
  }
  .float-card{
    position:absolute;background:rgba(37,18,71,.9);
    border:1px solid var(--border);border-radius:14px;
    padding:14px 18px;backdrop-filter:blur(8px);
    box-shadow:0 14px 40px rgba(0,0,0,.35);
    animation:float 5s ease-in-out infinite;z-index:3;
  }
  .float-card h4{color:var(--yellow);font-size:11px;letter-spacing:2px;margin-bottom:4px}
  .float-card p{color:var(--muted);font-size:12px;line-height:1.45;max-width:170px}
  .fc1{top:6%;left:-2%;animation-delay:0s}
  .fc2{top:42%;right:-4%;animation-delay:1.6s}
  .fc3{bottom:26%;left:-4%;animation-delay:3.1s}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}

  .ba-preview{
    margin-top:40px;background:linear-gradient(145deg,var(--card),var(--card2));
    border:1px solid var(--border);border-radius:22px;padding:34px;
    box-shadow:0 0 55px rgba(123,77,255,.22);
  }
  /* Make the hero Before / After preview large enough to read analytics */
  @media(min-width:961px){
    .hero .ba-preview{
      grid-column:1 / -1;
      width:100%;
      margin-top:10px;
      padding:28px;
    }
    .hero .ba-item{padding:18px;}
    .hero .ba-item img{max-height:none; width:100%;}
  }
  @media(max-width:960px){
    .hero .ba-preview{margin-top:24px;}
  }
  .ba-preview .ba-title{
    text-align:center;color:var(--yellow);font-size:11px;font-weight:700;
    letter-spacing:2.5px;text-transform:uppercase;margin-bottom:14px;
  }
  .ba-row{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:8px;align-items:center}
  .ba-item{background:#0f0622;border:1px solid var(--border);border-radius:14px;padding:0;overflow:hidden}
  .ba-item .label{
    display:block;text-align:center;font-size:11px;font-weight:700;
    letter-spacing:2.5px;margin-bottom:10px;color:var(--muted);
  }
  .ba-item.after .label{color:var(--yellow)}
  .hero .ba-item{padding:0;}
  .ba-item img{
    display:block;
    width:100%;
    height:auto;
    max-height:none;
    object-fit:contain;
    border-radius:8px;
    background:#160a2e;
  }
  .ba-arrow{
    color:var(--yellow);font-size:26px;font-weight:900;
    text-shadow:0 0 18px rgba(255,211,53,.6);
  }
  @media(max-width:960px){
    .hero{grid-template-columns:1fr;gap:44px;padding-top:48px}
    .hero-copy{text-align:center}
    .hero-sub{margin:0 auto 32px}
    .hero-btns{justify-content:center}
    .float-card{position:static;animation:none;margin-top:10px}
    .float-wrap{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:16px}
  }
  @media(min-width:961px){.float-wrap{display:contents}}

  /* ---------- PROBLEM ---------- */
  .problem{
    background:linear-gradient(180deg,var(--bg),var(--bg2));
  }
  .problem-grid{
    display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:44px;
  }
  .p-card{
    background:var(--card);border:1px solid var(--border);border-radius:18px;
    padding:28px 24px;transition:transform .25s,border-color .25s;
  }
  .p-card:hover{transform:translateY(-6px);border-color:rgba(255,211,53,.5)}
  .p-card .num{color:var(--purple-soft);font-size:12px;font-weight:700;letter-spacing:2px}
  .p-card h3{font-size:17px;margin:10px 0 8px}
  .p-card p{color:var(--muted);font-size:14px}
  .problem-out{
    text-align:center;margin-top:56px;font-size:clamp(22px,3vw,32px);
    font-weight:800;letter-spacing:.5px;
  }
  .problem-out span{
    color:var(--yellow);
    text-shadow:0 0 30px rgba(255,211,53,.4);
  }
  @media(max-width:960px){.problem-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.problem-grid{grid-template-columns:1fr}}

  /* ---------- SYSTEM ---------- */
  .system-grid{
    display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:44px;
  }
  .s-card{
    background:linear-gradient(160deg,var(--card),var(--card2));
    border:1px solid var(--border);border-radius:18px;padding:26px 20px;
    transition:transform .25s;
  }
  .s-card:hover{transform:translateY(-6px)}
  .s-card .big{
    font-size:44px;font-weight:900;color:var(--yellow);
    text-shadow:0 0 26px rgba(255,211,53,.35);line-height:1;
  }
  .s-card h3{font-size:14px;letter-spacing:2px;margin-top:14px}
  @media(max-width:960px){.system-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:560px){.system-grid{grid-template-columns:repeat(2,1fr)}}

  /* ---------- PROCESS ---------- */
  .step{
    display:grid;grid-template-columns:1fr 1.15fr;gap:44px;align-items:center;
    margin-top:64px;
  }
  .step:nth-of-type(even){grid-template-columns:1.15fr 1fr}
  .step:nth-of-type(even) .step-copy{order:2}
  .step-copy .step-num{
    font-size:64px;font-weight:900;line-height:1;
    color:transparent;-webkit-text-stroke:1.5px var(--purple-soft);
  }
  .step-copy h3{font-size:26px;margin:12px 0 12px;letter-spacing:1px}
  .step-copy h3 em{color:var(--yellow);font-style:normal}
  .step-copy p{color:var(--muted);max-width:440px}
  .step-img{
    background:var(--card);border:1px solid var(--border);border-radius:20px;
    padding:18px;box-shadow:0 20px 60px rgba(0,0,0,.35),0 0 40px rgba(123,77,255,.12);
  }
  .step-img img{
    width:100%;height:auto;max-height:460px;object-fit:contain;
    border-radius:10px;background:#0f0622;
  }
  @media(max-width:860px){
    .step,.step:nth-of-type(even){grid-template-columns:1fr}
    .step:nth-of-type(even) .step-copy{order:0}
  }

  .month-badge{
    display:inline-block;margin-top:22px;
    background:rgba(255,211,53,.12);border:1px solid rgba(255,211,53,.55);
    color:var(--yellow);font-size:13px;font-weight:800;letter-spacing:3px;
    padding:12px 30px;border-radius:999px;
    box-shadow:0 0 30px rgba(255,211,53,.22);
  }

  /* ---------- RESULTS ---------- */
  .results{background:linear-gradient(180deg,var(--bg2),var(--bg))}
  .featured-grid{
    display:grid;grid-template-columns:1fr;gap:24px;margin-top:48px;
  }
  .featured{
    background:var(--card);border:1px solid var(--border);border-radius:20px;
    padding:34px;transition:transform .25s,border-color .25s;
  }
  .featured:hover{transform:translateY(-6px);border-color:rgba(255,211,53,.5)}
  .featured .pair{display:grid;grid-template-columns:minmax(0,1fr) 44px minmax(0,1fr);gap:14px;align-items:center}
  .featured img{
    width:100%;height:auto;max-height:980px;object-fit:contain;
    border-radius:10px;background:#0f0622;border:1px solid rgba(167,139,250,.15);
  }
  .featured .tag{
    text-align:center;font-size:10px;font-weight:700;letter-spacing:2px;
    color:var(--muted);margin-top:10px;
  }
  .gallery-grid{
    display:grid;grid-template-columns:1fr;gap:28px;margin-top:28px;
  }
  .gallery-item{
    background:var(--card);border:1px solid var(--border);border-radius:18px;padding:30px;
  }
  .gallery-item .pair{display:grid;grid-template-columns:1fr auto 1fr;gap:6px;align-items:center}
  .gallery-item img{
    width:100%;height:auto;max-height:900px;object-fit:contain;
    border-radius:8px;background:#0f0622;border:1px solid rgba(167,139,250,.15);
  }
  .mini-arrow{color:var(--yellow);font-size:16px;font-weight:900}
  @media(max-width:960px){.featured-grid{grid-template-columns:1fr}.gallery-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.gallery-grid{grid-template-columns:1fr}}

  /* ---------- TESTIMONIALS ---------- */
  .testi-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px;
  }
  .testi{
    background:var(--card);border:1px solid var(--border);border-radius:18px;
    padding:14px;transition:transform .25s;
  }
  .testi:hover{transform:translateY(-5px)}
  .testi img{
    width:100%;height:auto;max-height:420px;object-fit:contain;
    border-radius:10px;background:#0f0622;
  }
  @media(max-width:960px){.testi-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.testi-grid{grid-template-columns:1fr}}

  /* ---------- SERVICES ---------- */
  .services-grid{
    display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:48px;
  }
  .service{
    background:linear-gradient(160deg,var(--card),var(--card2));
    border:1px solid var(--border);border-radius:18px;padding:32px 24px;
    transition:transform .25s,border-color .25s;
  }
  .service:hover{transform:translateY(-6px);border-color:rgba(255,211,53,.5)}
  .service .icon{
    width:46px;height:46px;border-radius:12px;background:rgba(255,211,53,.12);
    display:flex;align-items:center;justify-content:center;margin-bottom:18px;
  }
  .service .icon svg{width:22px;height:22px;stroke:var(--yellow);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .service h3{font-size:15px;letter-spacing:1.5px}
  @media(max-width:960px){.services-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.services-grid{grid-template-columns:1fr}}

  /* ---------- FINAL CTA ---------- */
  .final{
    background:
      radial-gradient(ellipse at 50% 0%, rgba(123,77,255,.35), transparent 60%),
      linear-gradient(180deg,var(--bg2),#120826);
    border-top:1px solid var(--border);
    text-align:center;
  }
  .final h2{font-size:clamp(30px,4.6vw,54px)}
  .final .second{color:var(--yellow);text-shadow:0 0 34px rgba(255,211,53,.35)}
  footer{
    border-top:1px solid var(--border);margin-top:80px;padding:34px 24px;
    display:flex;flex-direction:column;align-items:center;gap:14px;
  }
  footer img{height:44px;width:auto}
  footer p{color:var(--muted);font-size:12px;letter-spacing:1px}

  /* HERO BEFORE / AFTER — show the complete screenshots, enlarged proportionally */
  .hero .ba-preview{
    width:100%;
    padding:22px;
  }
  .hero .ba-row{
    grid-template-columns:minmax(0,1fr) 42px minmax(0,1fr);
    gap:18px;
    align-items:center;
  }
  .hero .ba-item{
    padding:0;
    min-height:0;
    height:auto;
    overflow:hidden;
  }
  .hero .ba-item img{
    width:100%;
    height:auto;
    max-height:none;
    transform:none;
    object-fit:contain;
  }

</style>
<base target="_blank">
</head>
