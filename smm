  </div>
</div>

<!-- HERO -->
<section class="hero" id="home">
  <div class="hero-copy">
    <span class="kicker">Social Media Management</span>
    <h1>YOUR CONTENT ISN'T THE PROBLEM.<br><span class="yellow">YOUR STRATEGY IS.</span></h1>
