  <div class="hero-visual">
    <div class="profile-wrap">
      <img class="profile-img" src="https://assets.cdn.filesafe.space/SE5erRrSgZF2j1lHjHt0/media/6ab9a9a6c13d4373c2cd199a.png" alt="Profile">
    </div>
    <div class="float-wrap">
      <div class="float-card fc1">
        <h4>RESEARCH</h4>
        <p>Find what the audience cares about.</p>
      </div>
      <div class="float-card fc2">
        <h4>CONTENT STRATEGY</h4>
        <p>Turn insights into content that has a purpose.</p>
