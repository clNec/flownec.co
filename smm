  <nav class="nav">
    <a href="#home" class="nav-logo"><img src="https://assets.cdn.filesafe.space/SE5erRrSgZF2j1lHjHt0/media/6ab9a98fbe703c7b302ed92c.png" alt="Logo"></a>
    <ul class="nav-links">
